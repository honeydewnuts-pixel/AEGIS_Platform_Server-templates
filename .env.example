# ==========================================================
# AEGIS Environment Configuration
# Company: Honeydewnuts Nigerian Limited
#
# Copy this file to .env and fill in real values. Never commit .env.
# ==========================================================

APP_NAME=AEGIS
APP_VERSION=3.0.0
APP_ENV=development
DEBUG=False
# Only set True for local development - it makes FastAPI return full
# tracebacks in error responses, which leaks internals if left on in
# any environment reachable by anyone other than you.

HOST=0.0.0.0
PORT=8000

SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY

# Comma-separated shared API keys accepted on the X-API-Key header.
# Generate one with: python -c "from app.security import generate_secret_key; print(generate_secret_key())"
# Optional: set your own admin key value here for the FIRST startup only.
# If left blank, one is auto-generated and printed to the logs ONCE on
# first boot - copy it immediately, it can't be retrieved afterward.
# Per-subscriber mobile app keys are issued automatically when each
# subscription first activates (see app/security.py issue_api_key).
ADMIN_BOOTSTRAP_KEY=

# Base64-encoded 32-byte key for encrypting broker credentials at rest.
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AEGIS_MASTER_KEY=CHANGE_THIS_MUST_DECODE_TO_32_BYTES

# Comma-separated list of allowed frontend origins (no "*" - see main.py)
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0

# Worker pool
WORKER_IDLE_TIMEOUT_SECONDS=900
WORKER_JOB_TIMEOUT_SECONDS=30
MAX_CONCURRENT_WORKERS=10

# Payment providers
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_CHANGE_ME
FLUTTERWAVE_WEBHOOK_HASH=CHANGE_THIS_SET_SAME_VALUE_IN_FLUTTERWAVE_DASHBOARD
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Subscription enforcement
SUBSCRIPTION_GRACE_PERIOD_DAYS=5
SUBSCRIPTION_SWEEP_INTERVAL_SECONDS=300
APK_FILE_PATH=release/aegis-mobile.apk
DOWNLOAD_TOKEN_TTL_SECONDS=3600

# Tracing (Tempo) - off by default, enable once the docker-compose Tempo
# service is actually running
TRACING_ENABLED=False
OTLP_ENDPOINT=tempo:4317
