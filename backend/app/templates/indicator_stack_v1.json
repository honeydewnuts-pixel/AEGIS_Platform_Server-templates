  "install_order": [
    {
      "slot": 1,
      "panel": "indicator",
      "mt5_name": "Bollinger Bands",
      "display_name": "Bands34 (#1 White)",
      "params": {
        "Period": 34,
        "Deviation": 1.618,
        "Shift": 0
      },
      "color": "White",
      "notes": "Stationary reference bands. Apply first on indicator panel."
    },
    {
      "slot": 2,
      "panel": "indicator",
      "mt5_name": "Bollinger Bands",
      "display_name": "Bands17 (#2 Bright Green)",
      "params": {
        "Period": 17,
        "Deviation": 2.618,
        "Shift": 0
      },
      "color": "Lime / Bright Green",
      "notes": "Motional bands. Same panel as #1."
    },
    {
      "slot": 3,
      "panel": "indicator",
      "mt5_name": "Williams' Percent Range",
      "display_name": "Williams %R 60 (#3 Orange)",
      "params": {
        "Period": 60
      },
      "color": "Orange",
      "notes": "Own subwindow or stacked per AEGIS template screenshot."
    },
    {
      "slot": 4,
      "panel": "indicator",
      "mt5_name": "Moving Average",
      "display_name": "MA7 (#4 Magenta)",
      "params": {
        "Period": 7,
        "Method": "SMA",
        "Apply to": "Close"
      },
      "color": "Magenta",
      "notes": "Must render magenta for CV detection."
    },
    {
      "slot": 5,
      "panel": "indicator",
      "mt5_name": "Commodity Channel Index",
      "display_name": "CCI6 (#5 Red)",
      "params": {
        "Period": 6
      },
      "color": "Red",
      "notes": "Red line only."
    },
    {
      "slot": 6,
      "panel": "indicator",
      "mt5_name": "Relative Strength Index",
      "display_name": "RSI9 (#6 Cyan)",
      "params": {
        "Period": 9
      },
      "color": "Cyan",
      "notes": "Cyan/cobalt line."
    },
    {
      "slot": 7,
      "panel": "price",
      "mt5_name": "Bollinger Bands",
      "display_name": "Main BB White (#7)",
      "params": {
        "Period": 34,
        "Deviation": 1.618
      },
      "color": "White",
      "notes": "On main price chart."
