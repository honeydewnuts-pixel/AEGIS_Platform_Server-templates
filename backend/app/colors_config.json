  "candle_colors": {
    "bullish_rgb": [0, 255, 0],
    "bearish_rgb": [255, 0, 0]
  },

  "cross_detection": {
    "primary_signal": "#2(2M)",
    "reference_upper": "#1(1U)",
    "reference_middle": "#1(1M)",
    "reference_lower": "#1(1L)",

    "signals": [
      "#2(2M)_CROSSED_ABOVE_#1(1U)",
      "#2(2M)_CROSSED_BELOW_#1(1L)"
    ],

    "minimum_cross_pixels": 3,
    "minimum_confirmation_candles": 2,
    "maximum_gap_pixels": 2
  },

  "history": {
    "max_frames_kept": 60,
    "divergence_lookback_frames": 12,
    "higher_high_lookback_frames": 8,
    "ttl_seconds": 600
  },

  "noise_filter": {
    "median_filter": 3,
    "gaussian_kernel": 5,
    "minimum_line_length": 20,
    "minimum_contour_area": 12
  },

  "output": {
    "coordinate_system": "Pixel",
    "extract_per_candle": true,
    "return_confidence": true
  }
