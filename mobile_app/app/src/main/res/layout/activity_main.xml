<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/aegis_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AEGIS"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/aegis_gold"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intelligence · Capture · Decide"
            android:textSize="12sp"
            android:textColor="@color/aegis_teal"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/runningStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ Stopped"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/aegis_muted"
            android:layout_marginBottom="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startBtn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="START"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_start_bg"
                android:padding="14dp"/>

            <Button
                android:id="@+id/stopBtn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="STOP"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_stop_bg"
                android:padding="14dp"
                android:layout_marginStart="10dp"
                android:enabled="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/settingsBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="SETTINGS"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_secondary_bg"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/accessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ENABLE MT5 DETECTION (Accessibility)"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_teal_bg"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_signal_bg"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE SIGNAL"
                android:textSize="11sp"
                android:textColor="@color/aegis_gold"
                android:letterSpacing="0.15"
                android:gravity="center"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HOLD"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confidence: —"
                android:textSize="14sp"
                android:textColor="@color/aegis_teal"
                android:gravity="center"/>

            <TextView
                android:id="@+id/ruleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rule: —"
                android:textSize="13sp"
                android:textColor="@color/aegis_muted"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/detailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Waiting for Brain..."
                android:textSize="14sp"
                android:textColor="@color/aegis_text"
                android:gravity="center"/>
        </LinearLayout>

        <TextView
            android:id="@+id/healthText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Not started"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="@color/aegis_muted"/>

        <TextView
            android:id="@+id/diagText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="12dp"
            android:background="@drawable/card_diag_bg"
            android:textColor="@color/aegis_teal"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="Backend Reachable: —\nLast Upload: —\nLast HTTP Code: —\nLast Upload Time: —\nCached Screenshots: 0\nMT5 Foreground: —"/>

        <Button
            android:id="@+id/batteryBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ALLOW BACKGROUND RUNNING"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_orange_bg"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/indicatorSetupBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="INSTALL / UPDATE INDICATOR TEMPLATE"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_purple_bg"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/minimizeBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="MINIMIZE + OPEN MT5"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_secondary_bg"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/floatHudBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="FLOATING HUD (drag overlay)"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_teal_bg"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/connectMt5Btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CONNECT MT5 TO BACKEND"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_secondary_bg"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
