<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AEGIS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/runningStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stopped"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="#888888"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/startBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="START"
                android:textSize="16sp"
                android:padding="14dp"/>

            <Button
                android:id="@+id/stopBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STOP"
                android:textSize="16sp"
                android:padding="14dp"
                android:layout_marginStart="8dp"
                android:enabled="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/settingsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textSize="15sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/accessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OPEN ACCESSIBILITY SETTINGS"
            android:textSize="13sp"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="24dp"
            android:text="HOLD"
            android:textSize="42sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#9E9E9E"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/confidenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Confidence: —"
            android:textSize="15sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/ruleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="#666666"/>

        <TextView
            android:id="@+id/detailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Waiting for Brain..."
            android:textSize="15sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/healthText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Not started"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="#888888"/>

        <TextView
            android:id="@+id/diagText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:background="#ECEFF1"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="Backend Reachable: —\nLast Upload: —\nLast HTTP Code: —\nLast Upload Time: —\nCached Screenshots: 0\nMT5 Foreground: —"/>

        <Button
            android:id="@+id/batteryBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALLOW BACKGROUND RUNNING (recommended)"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/indicatorSetupBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INSTALL / UPDATE INDICATOR TEMPLATE"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/floatHudBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FLOATING HUD (minimize / drag)"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/connectMt5Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONNECT MT5 TO BACKEND"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
